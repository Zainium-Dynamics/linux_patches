maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=linux-kernel
pkgver=7.3.1
pkgrel=0
# the one place the kernel's name is set: the image is kernel/$_kernel and the release
# $_kernel-<major>.<minor>, so the module dir and boot paths stay the same across point releases
_kernel=linux-zainium
_krel="$_kernel-${pkgver%.*}"
# the kernel goes to the kernel tier (ESP, `zex kernel`); its modules to the base
subpackages="linux-kernel-modules linux-headers"
# GNU sed: AppArmor's capability names are generated with sed's \L, which BusyBox sed
# writes as a literal "L" ("LCHOWN"), so the parser could not match any capability
makedepends="bash clang-dev flex bison bc perl python3 gawk sed rsync findutils diffutils coreutils tar xz zstd cpio kmod elfutils-dev openssl openssl-dev pahole linux-headers qemu-system-x86_64"
source="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
0001-zainium-system-paths.patch
0002-zainium-module-dir.patch
zainium.config"

# Vanilla Linux with Zainium's system paths (firmware, shebangs, init, modprobe, poweroff)
# and the modules under /overlayer/syshub; the release name is given to make (kmake).
# zainium.config is Zainium's own kernel config; build() only adds the desktop-speed
# options to it. Built with GCC like that config: with Rust and BTF both on, the kernel
# does not allow LTO.
# KERNELRELEASE on make's command line is the release as it is (no setlocalversion, no "+")
kmake() {
	make KERNELRELEASE="$_krel" "$@"
}

build() {
	cd "$SRCDIR/linux-$pkgver"
	# the musl loader flags ci/build.sh exports are for userland, not the kernel; with the Rust
	# one bindgen would run on Zainium's loader and could not find libstdc++ for Alpine's libclang;
	# it also has to be linked dynamically, a static musl bindgen cannot dlopen libclang
	unset CFLAGS CPPFLAGS LDFLAGS CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS

	# Rust in the kernel: stable rustc with rust-src, and bindgen (rustup comes from the CI job)
	rustup toolchain install stable --profile minimal --component rust-src
	export RUSTUP_TOOLCHAIN=stable
	RUSTFLAGS="-C target-feature=-crt-static" cargo install --locked --root "$SRCDIR/bindgen" bindgen-cli
	export PATH="$SRCDIR/bindgen/bin:$PATH"

	for p in 0001-zainium-system-paths.patch 0002-zainium-module-dir.patch; do
		patch -p1 < "$SRCDIR/$p"
	done

	cp "$SRCDIR/zainium.config" .config
	# desktop speed on top of Zainium's config: transparent hugepages, zstd for zram, no
	# scheduler stats (x86-64-v3 and -O3 are compiler flags below: vanilla has no options for them)
	scripts/config -e GENERIC_CPU -e CC_OPTIMIZE_FOR_PERFORMANCE \
		-e TRANSPARENT_HUGEPAGE -e TRANSPARENT_HUGEPAGE_ALWAYS \
		-d ZRAM_DEF_COMP_LZORLE -e ZRAM_DEF_COMP_ZSTD \
		-d SCHEDSTATS -d LATENCYTOP \
		-d DEBUG_INFO_COMPRESSED_NONE -e DEBUG_INFO_COMPRESSED_ZSTD \
		-d X86_DECODER_SELFTEST
	# X86_DECODER_SELFTEST builds arch/x86/tools/insn_sanity with the host compiler, which
	# cannot take the kernel's uapi headers on the musl build host; it is a build-time test only
	kmake olddefconfig
	kmake rustavailable
	# olddefconfig silently drops what the toolchain cannot do (Rust without rustc/bindgen)
	for opt in CONFIG_RUST=y CONFIG_DEBUG_INFO_BTF=y \
		CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y CONFIG_TRANSPARENT_HUGEPAGE=y; do
		grep -qx "$opt" .config || { echo "olddefconfig dropped $opt" >&2; return 1; }
	done
	# the live image is zstd EROFS mounted from the initramfs: every built-in EROFS
	# option of Zainium's config must stay built in (ONDEMAND no longer exists in 7.1.8)
	for opt in $(grep '^CONFIG_EROFS_FS[A-Z_]*=y$' "$SRCDIR/zainium.config" | grep -v '^CONFIG_EROFS_FS_ONDEMAND='); do
		grep -qx "$opt" .config || { echo "olddefconfig dropped $opt" >&2; return 1; }
	done
	[ "$(kmake -s kernelrelease)" = "$_krel" ] || { echo "kernelrelease is not $_krel" >&2; return 1; }

	# x86-64-v3 (AVX2, Haswell and newer) and -O3 for the C and the Rust code
	kmake -j"$(nproc)" KCFLAGS="-march=x86-64-v3 -O3" KRUSTFLAGS="-Ctarget-cpu=x86-64-v3" bzImage modules
	_boot_test
}

# The kernel has to boot on an x86-64-v3 CPU and start the initramfs init from
# Zainium's path (/quantra-ramfs) on its own; the test init prints a marker and powers off.
_boot_test() {
	t="$SRCDIR/boot-test"
	rm -rf "$t"
	mkdir -p "$t"
	cat > "$t/init.c" <<'EOF'
#include <stdio.h>
#include <sys/reboot.h>
#include <sys/utsname.h>
#include <unistd.h>

int main(void)
{
	struct utsname u;

	uname(&u);
	printf("ZAINIUM_BOOT_OK %s\n", u.release);
	fflush(stdout);
	sync();
	reboot(RB_POWER_OFF);
	return 0;
}
EOF
	cc -static -O2 -o "$t/init" "$t/init.c"
	printf 'dir /dev 0755 0 0\nnod /dev/console 0600 0 0 c 5 1\nfile /quantra-ramfs %s 0755 0 0\n' "$t/init" > "$t/list"
	usr/gen_init_cpio "$t/list" | gzip -9 > "$t/initrd.gz"

	timeout 900 qemu-system-x86_64 -m 1024 -smp 2 -cpu max -nographic -no-reboot \
		-kernel arch/x86/boot/bzImage -initrd "$t/initrd.gz" \
		-append "console=ttyS0 panic=-1" > "$t/boot.log" 2>&1 || true
	if ! grep -q "ZAINIUM_BOOT_OK $_krel" "$t/boot.log"; then
		tail -60 "$t/boot.log"
		echo "boot test failed: no ZAINIUM_BOOT_OK $_krel" >&2
		return 1
	fi
	grep "ZAINIUM_BOOT_OK" "$t/boot.log"
}

# the kernel image only: `zex kernel` puts it on the ESP, where Limine boots it.
# linux-panic is the fallback entry's kernel (the boot menu's "Fallback Kernel"), as in zaisys
package() {
	cd "$SRCDIR/linux-$pkgver"
	mkdir -p "$PAYLOAD_DIR/kernel"
	cp arch/x86/boot/bzImage "$PAYLOAD_DIR/kernel/$_kernel"
	cp arch/x86/boot/bzImage "$PAYLOAD_DIR/kernel/linux-panic"
}

# the modules for the base (drivers/modules/<release>), staged by `zex kernel` after asking
modules() {
	cd "$SRCDIR/linux-$pkgver"
	kmake INSTALL_MOD_PATH="$PAYLOAD_DIR" INSTALL_MOD_STRIP=1 DEPMOD=true modules_install
	mods="$PAYLOAD_DIR/overlayer/syshub/drivers/modules/$_krel"
	rm -f "$mods/build" "$mods/source"

	# modules.dep and friends; depmod only takes a numeric release under lib/modules
	scratch=$(mktemp -d)
	mkdir -p "$scratch/lib/modules"
	ln -s "$mods" "$scratch/lib/modules/0.0-$_krel"
	depmod -a -b "$scratch" -F System.map "0.0-$_krel"
	rm -rf "$scratch"
	[ -s "$mods/modules.dep" ] || { echo "depmod wrote no modules.dep" >&2; return 1; }
}

# the kernel's userspace API headers, from the same tree, for the userland
# (/overlayer/zexlib/union/include)
linux_headers() {
	cd "$SRCDIR/linux-$pkgver"
	kmake INSTALL_HDR_PATH="$PAYLOAD_DIR" headers_install
	find "$PAYLOAD_DIR" \( -name .install -o -name ..install.cmd \) -exec rm -f {} +
	# substrate allows no /usr in a package; in the headers it is only comments
	grep -rlI '/usr/' "$PAYLOAD_DIR" | xargs -r sed -i 's#/usr/#/overlayer/syshub/#g'
}
