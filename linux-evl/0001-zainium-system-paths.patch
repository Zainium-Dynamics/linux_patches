+	/* --- ZAINIUM OS: redirect legacy FHS interpreter paths ------------
+	 * Zainium has no /bin, /usr/bin, etc. at all — every interpreter a
+	 * shebang can legally name lives under /overlayer/syshub/bin/
+	 * instead. Rewriting only three exact paths (sh/bash/env) misses
+	 * everything else a real shebang commonly names (perl, python3,
+	 * dash, awk, gawk, sed, make, ...) — this matches on the FHS
+	 * *prefix* instead and keeps whatever interpreter name follows it,
+	 * so all of those are covered by the same rule.
+	 *
+	 * `redirected` is a plain stack (automatic) buffer, not `static` —
+	 * load_script() runs concurrently for every exec() on the system,
+	 * a shared static buffer here would let two processes racing on
+	 * this function corrupt each other's interpreter path.
+	 *
+	 * Only when the named interpreter does not exist: inside a flatpak
+	 * sandbox or container /usr/bin/sh is real and /overlayer is absent.
+	 */
+	{
+		static const char *const legacy_roots[] = {
+			"/usr/local/bin/", "/usr/local/sbin/",
+			"/usr/bin/", "/usr/sbin/",
+			"/bin/", "/sbin/",
+		};
+		char redirected[BINPRM_BUF_SIZE];
+		size_t i;
+		struct path found;
+		bool exists = !kern_path(i_name, LOOKUP_FOLLOW, &found);
+
+		if (exists)
+			path_put(&found);
+		for (i = 0; !exists && i < ARRAY_SIZE(legacy_roots); i++) {
+			size_t root_len = strlen(legacy_roots[i]);
+
+			if (!strncmp(i_name, legacy_roots[i], root_len)) {
+				scnprintf(redirected, sizeof(redirected),
+					  "/overlayer/syshub/bin/%s",
+					  i_name + root_len);
+				i_name = redirected;
+				break;
+			}
+		}
+
+		retval = copy_string_kernel(i_name, bprm);
+		if (retval)
+			return retval;
+	}
+	/* --- ZAINIUM OS PATCH END ----------------------------------------- */
 	bprm->argc++;
 	retval = bprm_change_interp(i_name, bprm);
 	if (retval < 0)
