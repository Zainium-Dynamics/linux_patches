diff --git a/scripts/depmod.sh b/scripts/depmod.sh
index 3c34fecac..d2fa0ac4e 100755
--- a/scripts/depmod.sh
+++ b/scripts/depmod.sh
@@ -25,8 +25,13 @@ if [ -z $(command -v $DEPMOD) ]; then
 	exit 0
 fi
 
-set -- -ae -F "${objtree}/System.map"
-if test -n "$INSTALL_MOD_PATH"; then
-	set -- "$@" -b "$INSTALL_MOD_PATH"
-fi
-exec "$DEPMOD" "$@" "$KERNELRELEASE"
+# Zainium: modules live under /overlayer/syshub/drivers/modules (MODLIB), and
+# depmod rejects a non-numeric release like linux-evl-7.1 on its command
+# line, so run it on a numeric alias of the module dir in a scratch root.
+moddir=/overlayer/syshub/drivers/modules
+alias="0.0-${KERNELRELEASE}"
+scratch=$(mktemp -d)
+trap 'rm -rf "$scratch"' EXIT
+mkdir -p "$scratch$moddir"
+ln -s "${INSTALL_MOD_PATH}$moddir/$KERNELRELEASE" "$scratch$moddir/$alias"
+"$DEPMOD" -ae -F "${objtree}/System.map" -b "$scratch" -m "$moddir" "$alias"
