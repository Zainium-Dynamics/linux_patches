maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=linux-evl
pkgver=7.1.8
pkgrel=0
_tag=cachyos-7.1.8-1
_krel=linux-evl-7.1
makedepends="bash clang lld llvm flex bison bc perl python3 gawk findutils diffutils coreutils tar xz zstd cpio kmod elfutils-dev openssl openssl-dev pahole linux-headers qemu-system-x86_64"
source="https://github.com/CachyOS/linux/archive/refs/tags/$_tag.tar.gz
0001-bore-cachy.patch
0002-zainium-system-paths.patch
0003-zainium-kernel-release.patch
zainium.config"
sha256sums="e181cae2157d3cf7bb3417422e7c7d9f561284c131c8bcc51a70cf6325b89be8  $_tag.tar.gz"

# CachyOS's 7.1 tree (its base patches already applied), BORE scheduler on top,
# then Zainium's system paths (firmware, shebangs, init, modprobe, poweroff) and
# release name. The release stays linux-evl-7.1 so the module dir and boot paths
# do not change. Built with clang ThinLTO, -O3, x86-64-v3.
build() {
	cd "$SRCDIR/linux-$_tag"
	# the musl loader flags ci/build.sh exports are for userland, not the kernel
	unset CFLAGS CPPFLAGS LDFLAGS

	for p in 0001-bore-cachy.patch 0002-zainium-system-paths.patch 0003-zainium-kernel-release.patch; do
		patch -p1 < "$SRCDIR/$p"
	done

	cp "$SRCDIR/zainium.config" .config
	make LLVM=1 olddefconfig
	# a clang that cannot do these silently drops them in olddefconfig
	for opt in CONFIG_CACHY=y CONFIG_SCHED_BORE=y CONFIG_LTO_CLANG_THIN=y CONFIG_X86_64_VERSION=3 \
		CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y CONFIG_TRANSPARENT_HUGEPAGE=y; do
		grep -qx "$opt" .config || { echo "olddefconfig dropped $opt" >&2; return 1; }
	done
	[ "$(make LLVM=1 -s kernelrelease)" = "$_krel" ] || { echo "kernelrelease is not $_krel" >&2; return 1; }

	make LLVM=1 -j"$(nproc)" bzImage modules
	_boot_test
}

# The kernel has to boot on an x86-64-v3 CPU and start the initramfs init from
# Zainium's path (/quantra-ramfs) on its own; the test init prints a marker and powers off.
_boot_test() {
	t="$SRCDIR/boot-test"
	rm -rf "$t"
	mkdir -p "$t"
	cat > "$t/init.c" <<'EOF'
#include <stdio.h>
#include <sys/reboot.h>
#include <sys/utsname.h>
#include <unistd.h>

int main(void)
{
	struct utsname u;

	uname(&u);
	printf("ZAINIUM_BOOT_OK %s\n", u.release);
	fflush(stdout);
	sync();
	reboot(RB_POWER_OFF);
	return 0;
}
EOF
	cc -static -O2 -o "$t/init" "$t/init.c"
	printf 'dir /dev 0755 0 0\nnod /dev/console 0600 0 0 c 5 1\nfile /quantra-ramfs %s 0755 0 0\n' "$t/init" > "$t/list"
	usr/gen_init_cpio "$t/list" | gzip -9 > "$t/initrd.gz"

	timeout 900 qemu-system-x86_64 -m 1024 -smp 2 -cpu max -nographic -no-reboot \
		-kernel arch/x86/boot/bzImage -initrd "$t/initrd.gz" \
		-append "console=ttyS0 panic=-1" > "$t/boot.log" 2>&1 || true
	if ! grep -q "ZAINIUM_BOOT_OK $_krel" "$t/boot.log"; then
		tail -60 "$t/boot.log"
		echo "boot test failed: no ZAINIUM_BOOT_OK $_krel" >&2
		return 1
	fi
	grep "ZAINIUM_BOOT_OK" "$t/boot.log"
}

package() {
	cd "$SRCDIR/linux-$_tag"
	mkdir -p "$PAYLOAD_DIR/kernel"
	cp arch/x86/boot/bzImage "$PAYLOAD_DIR/kernel/linux-evl"
	# the boot menu's fallback entry boots the same image
	cp arch/x86/boot/bzImage "$PAYLOAD_DIR/kernel/linux-panic"

	make LLVM=1 INSTALL_MOD_PATH="$PAYLOAD_DIR" INSTALL_MOD_STRIP=1 DEPMOD=true modules_install
	mods="$PAYLOAD_DIR/overlayer/syshub/drivers/modules/$_krel"
	rm -f "$mods/build" "$mods/source"

	# modules.dep and friends; depmod only takes a numeric release under lib/modules
	scratch=$(mktemp -d)
	mkdir -p "$scratch/lib/modules"
	ln -s "$mods" "$scratch/lib/modules/0.0-$_krel"
	depmod -a -b "$scratch" -F System.map "0.0-$_krel"
	rm -rf "$scratch"
	[ -s "$mods/modules.dep" ] || { echo "depmod wrote no modules.dep" >&2; return 1; }
}
